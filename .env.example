# Copy to `.env` (git-ignored), or run:  python -m config.make_env
# which copies this file and fills in a new secret key.

# Required. Signs the session data. Any long random string; keep it private.
DJANGO_SECRET_KEY=

# False: visitors get friendly error pages. True: Django shows debug pages with
# stack traces. Use True only while developing on your own machine.
DJANGO_DEBUG=False

# Optional settings; the defaults are shown.
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Send the session cookie over HTTPS only. Turn on when the site runs behind HTTPS.
# DJANGO_SECURE_COOKIES=False
# Folder with <model_key>/fold_<k>/best_model.pt (absolute, or relative to this folder).
# MODEL_STORE_DIR=model_store
# Largest 2D scan upload in bytes (20 MB).
# SCAN_MAX_UPLOAD_BYTES=20971520
# Behind an HTTPS proxy only (set by the sharing launcher, deploy/tunnel/share.py):
# DJANGO_BEHIND_PROXY=False
# DJANGO_CSRF_TRUSTED_ORIGINS=

# Trained checkpoints, uploads, local secrets, local DB — never committed
model_store/*
!model_store/.gitkeep
media/*
!media/.gitkeep
.env
db.sqlite3

# Virtual environment (folder or symlink)
.venv

# Python / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Django collected static files
staticfiles/

# OS / editor
.DS_Store
.vscode/
.idea/

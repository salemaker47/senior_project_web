# Trained checkpoints, uploads, local secrets, local DB — never committed
model_store/*
!model_store/.gitkeep
media/*
!media/.gitkeep
.env
db.sqlite3

# Virtual environment (folder or symlink)
.venv

# Python / tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# OS / editor
.DS_Store
.vscode/
.idea/

# Golden reference pairs: real dataset images and masks, valid only together
# with the matching model in model_store/. Kept local, like model_store/.
tests/golden/*/

# Data of the public sharing mode (deploy/tunnel/): its own database, uploads, logs
share_data/

# Front-door page: a status file made for a local check (the launcher writes the real one elsewhere)
deploy/pages/status.json
